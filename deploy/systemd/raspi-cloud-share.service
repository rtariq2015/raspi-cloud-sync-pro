[Unit]
Description=Raspi Cloud Sync Pro disposable-test Samba staging and backup worker
After=network.target
ConditionPathExists=/etc/raspi-cloud-sync-pro/DISPOSABLE_TEST_APPROVED

[Service]
Type=simple
User=raspi-backup
Group=raspi-sync
UMask=0077
ExecStart=/opt/raspi-cloud-sync-pro/venv/bin/python -m raspi_cloud_sync_pro share-service --config /etc/raspi-cloud-sync-pro/share-service.json
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/raspi-cloud-sync-pro/smb-staging /var/lib/raspi-cloud-sync-pro/smb-state
# No Install section; approval marker alone cannot lift the Python code gate.
