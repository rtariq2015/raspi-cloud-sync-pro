[Unit]
Description=Raspi Cloud Sync Pro disposable-test USB-local DHCP
After=network.target
ConditionPathExists=/etc/raspi-cloud-sync-pro/DISPOSABLE_TEST_APPROVED

[Service]
Type=simple
User=root
ExecStartPre=/opt/raspi-cloud-sync-pro/venv/bin/python -m raspi_cloud_sync_pro device-gate --mode ethernet_samba --device-policy /etc/raspi-cloud-sync-pro/device.json
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/raspi-cloud-sync-pro/usb-dhcp.conf
Restart=no
NoNewPrivileges=yes
# Does not install forwarding, NAT, DNS service or host Internet sharing.
