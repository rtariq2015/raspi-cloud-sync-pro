[Unit]
Description=Uploads new files in directory
After=multi-user.target
[Service]
Type=simple
User=pi
Restart=no
# Raspi Cloud Sync Pro: legacy hardware/runtime activation is disabled.
# Upstream ExecStart=/usr/bin/python3 /home/pi/upload_new_files.py
ExecStart=/usr/bin/false
[Install]
WantedBy=multi-user.target
