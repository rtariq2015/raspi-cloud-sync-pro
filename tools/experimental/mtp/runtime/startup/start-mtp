#!/usr/bin/python3 -I
"""Fixed, explicitly approved MTP startup entry point; never installs itself."""
import sys
from pathlib import Path

sys.dont_write_bytecode = True
site = Path("/opt/raspi-cloud-sync-pro/experimental/mtp/site")
if not site.is_dir():
    raise SystemExit("MTP startup is not deployed")
sys.path.insert(0, str(site))
from raspi_cloud_sync_pro.mtp_startup import main

raise SystemExit(main())
