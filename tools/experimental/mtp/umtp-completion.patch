diff --git a/src/rcsp_mtp_completion.c b/src/rcsp_mtp_completion.c
new file mode 100644
index 0000000..051fd65
--- /dev/null
+++ b/src/rcsp_mtp_completion.c
@@ -0,0 +1,92 @@
+/* Raspi Cloud Sync Pro experimental adapter; GPL-3.0-or-later.
+ * No shell, USB setup, cloud configuration or host-owned block filesystem.
+ */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <signal.h>
+#include <spawn.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+#include "rcsp_mtp_completion.h"
+
+#ifndef RCSP_MTP_COMPLETION_HELPER
+#define RCSP_MTP_COMPLETION_HELPER "/opt/raspi-cloud-sync-pro/experimental/mtp/complete-object"
+#endif
+#ifndef RCSP_MTP_HELPER_TIMEOUT
+#define RCSP_MTP_HELPER_TIMEOUT 300
+#endif
+
+static double monotonic_now(void)
+{
+    struct timespec now;
+    if(clock_gettime(CLOCK_MONOTONIC, &now)) return -1;
+    return now.tv_sec + now.tv_nsec / 1000000000.0;
+}
+
+int rcsp_mtp_checkpoint(int fd, const char *relative, uint64_t size,
+                        uint32_t session, uint32_t transaction, uint32_t object)
+{
+    int reader = -1, status, error = -1, actions_ready = 0;
+    char fd_path[64], size_arg[32], session_arg[16], tx_arg[16], object_arg[16];
+    struct stat source, duplicate;
+    posix_spawn_file_actions_t actions;
+    pid_t child = -1, waited;
+    double deadline, now;
+    struct timespec pause = {0, 10000000};
+    char *argv[] = {RCSP_MTP_COMPLETION_HELPER, "--fd", "3", "--relative", (char*)relative,
+                    "--size", size_arg, "--session", session_arg, "--transaction", tx_arg,
+                    "--object", object_arg, NULL};
+    /* The helper gets no ambient loader/Python/path environment or credentials.
+     * Its fixed launcher owns private broker configuration. */
+    char *env[] = {"PATH=/usr/bin:/bin", "LANG=C.UTF-8", "LC_ALL=C.UTF-8", NULL};
+    if(!relative || !relative[0] || relative[0] == '/' || !session || size > RCSP_MTP_MAX_OBJECT_SIZE ||
+       fstat(fd, &source) || !S_ISREG(source.st_mode) || source.st_nlink != 1 || source.st_size != size)
+        return -1;
+    snprintf(fd_path, sizeof(fd_path), "/proc/self/fd/%d", fd);
+    reader = open(fd_path, O_RDONLY | O_CLOEXEC);
+    if(reader < 0 || fstat(reader, &duplicate) || source.st_dev != duplicate.st_dev ||
+       source.st_ino != duplicate.st_ino || source.st_size != duplicate.st_size) goto done;
+    snprintf(size_arg, sizeof(size_arg), "%" PRIu64, size);
+    snprintf(session_arg, sizeof(session_arg), "%" PRIu32, session);
+    snprintf(tx_arg, sizeof(tx_arg), "%" PRIu32, transaction);
+    snprintf(object_arg, sizeof(object_arg), "%" PRIu32, object);
+    if(posix_spawn_file_actions_init(&actions)) goto done;
+    actions_ready = 1;
+    if(posix_spawn_file_actions_adddup2(&actions, reader, 3) ||
+       posix_spawn_file_actions_addopen(&actions, 0, "/dev/null", O_RDONLY, 0) ||
+       posix_spawn_file_actions_addopen(&actions, 1, "/dev/null", O_WRONLY, 0) ||
+       posix_spawn_file_actions_adddup2(&actions, 1, 2) ||
+       posix_spawn_file_actions_addclosefrom_np(&actions, 4)) goto done;
+    now = monotonic_now();
+    if(now < 0) goto done;
+    deadline = now + RCSP_MTP_HELPER_TIMEOUT;
+    if(posix_spawn(&child, RCSP_MTP_COMPLETION_HELPER, &actions, NULL, argv, env)) {child = -1; goto done;}
+    for(;;) {
+        waited = waitpid(child, &status, WNOHANG);
+        if(waited == child) {child = -1; error = WIFEXITED(status) && WEXITSTATUS(status) == 0 ? 0 : -1; break;}
+        if(waited < 0 && errno != EINTR) goto done;
+        now = monotonic_now();
+        if(now < 0 || now >= deadline) goto done;
+        nanosleep(&pause, NULL);
+    }
+    if(fstat(fd, &duplicate) || source.st_dev != duplicate.st_dev || source.st_ino != duplicate.st_ino ||
+       source.st_size != duplicate.st_size || source.st_mtim.tv_sec != duplicate.st_mtim.tv_sec ||
+       source.st_mtim.tv_nsec != duplicate.st_mtim.tv_nsec) error = -1;
+done:
+    if(child > 0) {
+        /* Only this private helper child, never a service or gadget process. */
+        kill(child, SIGKILL);
+        do {waited = waitpid(child, &status, 0);} while(waited < 0 && errno == EINTR);
+    }
+    if(actions_ready) posix_spawn_file_actions_destroy(&actions);
+    if(reader >= 0) close(reader);
+    return error;
+}
diff --git a/src/rcsp_mtp_lifecycle.c b/src/rcsp_mtp_lifecycle.c
new file mode 100644
index 0000000..dce984e
--- /dev/null
+++ b/src/rcsp_mtp_lifecycle.c
@@ -0,0 +1,35 @@
+/* Raspi Cloud Sync Pro experimental MTP session invalidation; GPL-3.0-or-later. */
+#include "buildconf.h"
+#include <stdint.h>
+#include <pthread.h>
+#include "mtp.h"
+#include "rcsp_mtp_completion.h"
+
+uint64_t rcsp_mtp_epoch(mtp_ctx *ctx)
+{
+    return __atomic_load_n(&ctx->rcsp_session_epoch, __ATOMIC_SEQ_CST);
+}
+/* Caller holds inotify_mutex or is the single session thread before opening DB. */
+void rcsp_mtp_reset_pending(mtp_ctx *ctx)
+{
+    ctx->rcsp_send_armed = 0;
+    ctx->rcsp_send_txid = 0;
+    ctx->rcsp_send_session = 0;
+    ctx->rcsp_send_epoch = 0;
+    ctx->rcsp_info_epoch = 0;
+    ctx->SendObjInfoHandle = UINT32_MAX;
+    ctx->SendObjInfoSize = 0;
+    ctx->SendObjInfoOffset = 0;
+}
+/* EP0 may race a blocked receive. Invalidate atomically first; never wait for
+ * inotify_mutex while the receiver could be waiting for USB data. The receiver
+ * detects the changed epoch and resets on exit. Idle pending state is cleared
+ * immediately. Already completed immutable batches are never removed. */
+void rcsp_mtp_invalidate(mtp_ctx *ctx)
+{
+    __atomic_add_fetch(&ctx->rcsp_session_epoch, UINT64_C(1), __ATOMIC_SEQ_CST);
+    if(!pthread_mutex_trylock(&ctx->inotify_mutex)) {
+        rcsp_mtp_reset_pending(ctx);
+        pthread_mutex_unlock(&ctx->inotify_mutex);
+    }
+}
